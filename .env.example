# Local configuration examples; set explicitly in your shell. No automatic .env loading.
PORT=3000
APP_HOST=127.0.0.1
DATA_DIR=data
COOKIE_SECURE=false
ALLOWED_HOSTS=
LOG_REQUESTS=false
# Optional native OCR/browser paths. Packaged local WASM/model is the default.
# TESSERACT_PATH=C:\path\to\tesseract.exe
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Keys/checkpoint default to DATA_DIR/security; never change paths to reset enrollment/history.
# Keep production keys/anchors independently protected and retain them for backup verification.
# AUDIT_KEY_FILE=
# AUDIT_CHECKPOINT_FILE=
# MFA_KEY_FILE=
MFA_REQUIRED_ROLES=
# Example required roles: institution_admin,officer,supervisor,audit_reviewer

# Optional operator-owned JSON registers; all real sources default unverified.
POLICY_FILE=
PROCEDURE_FILE=
PROCEDURE_CONFIRMATIONS_FILE=

# Optional bounded ClamAV INSTREAM service. Unconfigured means UNSCANNED, not clean.
CLAMAV_HOST=
CLAMAV_PORT=3310
UPLOAD_SCAN_REQUIRED=false

# Setu SANDBOX only; no credentials are supplied or committed.
SETU_PRODUCT_INSTANCE_ID=
SETU_ACCESS_TOKEN=
# Alternatively configure SETU_CLIENT_ID and SETU_CLIENT_SECRET locally.
