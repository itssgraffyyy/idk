  "termDeposit": {
    "type": "term_deposit",
    "schemaVersions": [
      "1.2",
      "2.0.0"
    ],
    "source": "https://specifications.rebit.org.in/api_schema/account_aggregator/documentation/term_deposit_v2.0.0.html",
    "fields": [
      "principalAmount",
      "ifsc",
      "openingDate",
      "maturityDate",
      "currency"
    ],
    "limitations": [
      "No FDR receipt identifier supplied by these fields",
      "No bank name inferred from FIP",
      "Currency absent in legacy schema: do not infer INR amount"
    ]
  },
  "connectionStatus": "contract_tested_only; no credentials supplied"
