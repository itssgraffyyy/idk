  ],
  "requests": [
    {
      "method": "POST",
      "path": "/consents",
      "required": [
        "vua",
        "dataRange"
      ],
      "used": [
        "consentDuration",
        "fiTypes: TERM_DEPOSIT",
        "consentTypes: PROFILE,SUMMARY",
        "fetchType: ONETIME"
      ]
    },
    {
      "method": "GET",
      "path": "/consents/{request_id}"
    },
    {
      "method": "POST",
      "path": "/sessions",
      "required": [
        "consentId",
        "dataRange",
        "format"
      ]
    },
    {
      "method": "GET",
      "path": "/sessions/{session_id}"
    }
  ],
  "responseBinding": [
    "consent.id",
    "consent.status",
    "consent.detail.fiTypes",
    "consent.detail.consentExpiry",
    "session.id",
    "session.consentId",
